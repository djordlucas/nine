{
  "name": "nine-web",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../internal/api/openapi.yaml -o src/api/schema.d.ts",
    "build": "npm run -s gen:api && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "marked": "^18.1.1",
    "openapi-fetch": "^0.17.0",
    "preact": "^11.0.1",
    "preact-iso": "^2.12.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
